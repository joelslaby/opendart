#!/bin/bash
# Launcher for OpenDart.app. Hands off to Terminal.app rather than running
# python directly from this bundle's own process — a fresh unsigned app
# binary gets silently denied by macOS's per-app Documents-folder sandbox
# (TCC), but Terminal already has that access, so we ride on it instead.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
PYTHON="/Users/jhiesener/miniconda3/envs/darts/bin/python"
CMD="cd $DIR && $PYTHON darts.py; exit"

osascript -e "tell application \"Terminal\" to do script \"$CMD\"" >/dev/null 2>&1
